				setitemcolor	basicmenubutton forecolor 1 1 1 1;
				setitemcolor	enhancements_cosmetics_menubutton forecolor 1 .682 0 1;
				setitemcolor	enhancements_force_menubutton forecolor 1 .682 0 1;
