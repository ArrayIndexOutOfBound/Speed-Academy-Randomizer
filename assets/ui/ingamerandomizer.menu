		itemDef 
		{
			name				basicmenubutton
			group				none
			text				BASIC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				80 183 170 30
			font				3
			textscale			0.9
			textalignx			170
			textaligny			5
			textstyle			3
			textalign			ITEM_ALIGN_RIGHT
			forecolor			1 .682 0 1
			visible			1
			descText			"Basic Randomizer Settings - Speedrun compliant"

			mouseEnter 
			{ 
				show			basic_glow
			}
			mouseExit 
			{ 
				hide			basic_glow
			}	  	  
			action 
			{ 
				play			"sound/interface/button1.wav" ;

				show			randomizer_background ;
				show 			basic ;
				hide 			enhancements_cosmetics ;
				hide 			enhancements_force ;
